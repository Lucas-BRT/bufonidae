#!/bin/sh
set -eu

subject=$(git stripspace --strip-comments < "${1:?missing commit message file}" | head -n 1)
case "$subject" in
    'Merge '*|'Revert "'*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|refactor|test|ci|build|perf|style|revert)(\([a-z0-9._-]+\))?(!)?: [^[:space:]].*$'
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq "$pattern"; then
    printf '%s\n' 'Use a Conventional Commit: type(scope): description' >&2
    exit 1
fi
